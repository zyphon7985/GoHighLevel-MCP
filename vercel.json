{
  "version": 2,
  "builds": [
    {
      "src": "api/enrich-webhook.js",
      "use": "@vercel/node",
      "config": { "maxDuration": 800 }
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/enrich-webhook", "dest": "/api/enrich-webhook.js" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
