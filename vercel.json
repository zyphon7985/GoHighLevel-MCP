{
  "version": 2,
  "rewrites": [
    { "source": "/enrich-webhook", "destination": "/api/enrich-webhook" },
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/enrich-webhook.js": {
      "maxDuration": 800
    },
    "api/index.js": {
      "maxDuration": 60
    }
  }
}
