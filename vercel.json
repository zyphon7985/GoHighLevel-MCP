{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build && mkdir -p public",
  "rewrites": [
    { "source": "/enrich-webhook", "destination": "/api/enrich-webhook" },
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/enrich-webhook.js": {
      "maxDuration": 800
    },
    "api/index.js": {
      "maxDuration": 60
    }
  }
}
